# --- Core -------------------------------------------------------------------
# PostgreSQL 16+. Extensions btree_gist and citext must be installable by this role
# (or pre-created by a superuser; see README).
DATABASE_URL=postgres://aac:aac@localhost:5432/aac_dev
TEST_DATABASE_URL=postgres://aac:aac@localhost:5432/aac_test

# Public origin of this app (no trailing slash). Used for auth and payment return URLs.
APP_URL=http://localhost:3000

# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Payments ---------------------------------------------------------------
# "sandbox" = built-in simulated processor (no real money, clearly labelled in the UI).
# "stripe"  = live Stripe adapter (use sk_test_ keys for Stripe test mode).
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret used to sign simulated webhook events in sandbox mode (any random string).
SANDBOX_WEBHOOK_SECRET=

# --- Jobs -------------------------------------------------------------------
# Shared secret for POST /api/internal/jobs/* (cron-triggered maintenance jobs).
JOBS_SECRET=
